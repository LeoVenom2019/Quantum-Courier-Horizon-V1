{
  "name": "qch-game-project",
  "version": "0.1.0",
  "description": "QCH Game Project",
  "author": "Leonardo Dias",
  "private": true,
  "scripts": {
    "test:battle-media": "node --test lib/solar-interstellar-battle-media.test.mjs",
    "test:battle-waves": "node --test lib/solar-interstellar-battle-waves.test.mjs",
    "test:delivery-progress": "node --test lib/delivery-progress.test.mjs",
    "test:new-land-battle-music": "node --test lib/new-land-battle-music.test.mjs",
    "test:surface-war-music": "node --test lib/new-earth-surface-war-music.test.mjs",
    "test:new-earth-drop-sfx": "node --test lib/new-earth-drop-sfx.test.mjs lib/new-earth-boss-drop-flow.test.mjs",
    "test:route4-elite-visuals": "node --test lib/route4-elite-ship-visuals.test.mjs",
    "test:route4-interaction-sfx": "node --test lib/route4-interaction-sfx.test.mjs",
    "test:new-earth-mission-rewards": "node --test lib/new-earth-mission-rewards.test.mjs",
    "test:horizon-achievement-stats": "node --test lib/horizon-achievement-stats.test.mjs",
    "test:arcade-intro": "node --test lib/arcade-intro-flow.test.mjs",
    "test:robot-runner-ghost-sfx": "node --test lib/robot-runner-ghost-sfx.test.mjs",
    "test:robot-runner-maze": "node --test lib/robot-runner-maze.test.mjs",
    "test:research-timing": "node --test lib/research-timing.test.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "clean": "next clean",
    "desktop:build": "next build && node scripts/prepare-desktop-standalone.js",
    "desktop:dev": "npm run desktop:build && electron .",
    "desktop:pack": "npm run desktop:build && electron-builder --win --dir",
    "desktop:dist": "npm run desktop:build && npm run installer:assets && electron-builder --win nsis",
    "icon:generate": "node scripts/generate-qch-icon.js",
    "installer:assets": "node scripts/generate-installer-assets.js"
  },
  "dependencies": {
    "@google/genai": "^1.50.1",
    "@hookform/resolvers": "^5.2.1",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.15.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.leonardodias.qch",
    "productName": "Quantum Courier Horizon",
    "copyright": "Copyright © 2026 Leonardo Dias",
    "directories": {
      "output": "dist-desktop-test"
    },
    "files": [
      "electron/**/*",
      "qch.ico"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app/.next/standalone"
      }
    ],
    "win": {
      "icon": "qch.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "QCH-Setup-${version}.${ext}",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": "Quantum Courier Horizon",
      "shortcutName": "Quantum Courier Horizon",
      "runAfterFinish": true,
      "installerLanguages": "pt_BR",
      "language": "1046",
      "displayLanguageSelector": false,
      "installerIcon": "qch.ico",
      "uninstallerIcon": "qch.ico",
      "installerSidebar": "build/installer/installerSidebar.bmp",
      "uninstallerSidebar": "build/installer/installerSidebar.bmp",
      "installerHeader": "build/installer/installerHeader.bmp",
      "include": "build/installer/installer.nsh",
      "uninstallDisplayName": "Quantum Courier Horizon",
      "deleteAppDataOnUninstall": false
    },
    "electronDist": "node_modules/electron/dist",
    "disableAsarIntegrity": true,
    "asar": false
  }
}